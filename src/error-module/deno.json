{
    "$schema": "https://github.com/denoland/deno/raw/refs/heads/main/cli/schemas/config-file.v1.json",
    "name": "@denocraft/error-module",
    "version": "0.1.0",
    "exports": {
        ".": "./src/mod.ts"
    },
    "imports": {
        "@src": "./src/mod.ts",
        "@src/*": "./src/*",
        "@types/deno": "npm:@types/deno@^2.3.0/index.d.ts",
        "@types/mocha": "npm:@types/mocha@^10.0.10/index.d.ts"
    },
    "bench": {
        "include": ["tests/**/*.bench.ts", "tests/*.bench.ts"]
    },
    "compilerOptions": {
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "checkJs": false,
        "erasableSyntaxOnly": true,
        "exactOptionalPropertyTypes": true,
        "noErrorTruncation": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "strict": true,
        "strictBindCallApply": true,
        "strictBuiltinIteratorReturn": true,
        "strictFunctionTypes": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "types": [],
        "useUnknownInCatchVariables": true
    },
    "fmt": {
        "include": ["**/*.ts", "*.ts"]
    },
    "lint": {
        "include": ["**/*.ts", "*.ts"]
    },
    "tasks": {
        "lint": {
            "description": "Run linting tools against the project.",
            "command": "deno task eslint && deno task prettier"
        },
        "lint:ci": {
            "description": "Run linting tools against the project from inside a CI pipeline.",
            "command": "deno task eslint:ci && deno task prettier:ci"
        },
        "lint:fix": {
            "description": "Run linting tools against the project and fix any issues found.",
            "command": "deno task eslint:fix && deno task prettier:fix"
        },
        "eslint": {
            "description": "Run ESLint against the project.",
            "command": "eslint --cache ./src/ ./tests/"
        },
        "eslint:ci": {
            "description": "Run ESLint against the project from inside a CI pipeline.",
            "command": "eslint ./src/ ./tests/"
        },
        "eslint:fix": {
            "description": "Run ESLint against the project and fix any issues found.",
            "command": "eslint --cache --fix ./src/ ./tests/"
        },
        "prettier": {
            "description": "Run Prettier against the project.",
            "command": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --ignore-path ../../.gitignore --check ."
        },
        "prettier:ci": {
            "description": "Run Prettier against the project from inside a CI pipeline.",
            "command": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --ignore-path ../../.gitignore --check ."
        },
        "prettier:fix": {
            "description": "Run Prettier against the project and fix any issues found.",
            "command": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --ignore-path ../../.gitignore --check --write ."
        },
        "test": {
            "description": "Run the project unit tests.",
            "command": "mocha --config ./.mocharc.cjs"
        },
        "test:ci": {
            "description": "Run the project unit tests from inside a CI pipeline.",
            "command": "mocha --config ./.mocharc.cjs"
        }
    },
    "test": {
        "include": ["tests/**/*.spec.ts", "tests/*.spec.ts"]
    },
    "unstable": []
}
